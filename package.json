{
  "name": "vrcx-k",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "VRCX-K rewrite — Tauri 2 shell (src-tauri) + React UI (src) + Cordis host (host). See docs/architecture-proposal.md",
  "workspaces": [
    "host"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:host": "bun run --cwd host dev",
    "build:host": "bun run --cwd host build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest"
  }
}
